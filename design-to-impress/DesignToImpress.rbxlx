<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4"><Item class="Workspace" referent="RBX00000001"><Properties><string name="Name">Workspace</string></Properties><Item class="Part" referent="RBX00000000"><Properties><string name="Name">Baseplate</string><bool name="Anchored">true</bool><bool name="Locked">true</bool><Vector3 name="size"><X>2048</X><Y>16</Y><Z>2048</Z></Vector3><CoordinateFrame name="CFrame"><X>0</X><Y>-8</Y><Z>0</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Color3uint8 name="Color3uint8">4284769380</Color3uint8></Properties></Item></Item><Item class="ReplicatedStorage" referent="RBX00000006"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="Folder" referent="RBX00000005"><Properties><string name="Name">Shared</string></Properties><Item class="ModuleScript" referent="RBX00000002"><Properties><string name="Name">Catalog</string><ProtectedString name="Source"><![CDATA[--!strict
-- The catalogue: every item a player can place, plus wall and floor finishes.
-- Furniture is built from simple Parts so the game works with no imported models.
-- Each part is { Size, Offset, Color, Material?, Shape?, Rot?, Light? } where Offset
-- is the part's centre measured from the item's bottom-centre (y = 0 is the floor).

export type PartSpec = {
	Size: Vector3,
	Offset: Vector3,
	Color: Color3,
	Material: Enum.Material?,
	Shape: Enum.PartType?,
	Rot: Vector3?, -- degrees
	Light: { Brightness: number, Range: number, Color: Color3 }?,
}

export type Item = {
	Id: string,
	Name: string,
	Category: string,
	Price: number,
	Footprint: Vector3?, -- bounding box (x width, y height, z depth)
	Flat: boolean?, -- flat items (rugs) may overlap other items
	Parts: { PartSpec }?,
	Color: Color3?, -- walls / floors
	Material: Enum.Material?, -- walls / floors
}

local Catalog = {}

Catalog.Categories = { "Furniture", "Walls", "Floors", "Lighting", "Decor" }

local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

local function v(x: number, y: number, z: number): Vector3
	return Vector3.new(x, y, z)
end

local WOOD = rgb(150, 105, 65)
local DARK_WOOD = rgb(90, 60, 40)
local WHITE = rgb(240, 240, 235)
local BLACK = rgb(30, 30, 35)
local METAL = rgb(120, 120, 130)

local function legs(w: number, d: number, h: number, inset: number, color: Color3): { PartSpec }
	local out: { PartSpec } = {}
	for _, sx in { -1, 1 } do
		for _, sz in { -1, 1 } do
			table.insert(out, {
				Size = v(0.4, h, 0.4),
				Offset = v(sx * (w / 2 - inset), h / 2, sz * (d / 2 - inset)),
				Color = color,
				Material = Enum.Material.Wood,
			})
		end
	end
	return out
end

local function join(...: { PartSpec }): { PartSpec }
	local out: { PartSpec } = {}
	for _, list in { ... } do
		for _, p in list do
			table.insert(out, p)
		end
	end
	return out
end

